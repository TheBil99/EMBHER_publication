// Shared Nextflow settings. Nextflow reads this file from the directory it is launched in, and every workflow
// is launched from the repository root, so `launchDir` is the project root: data/ and results/ hang off it.
//
//   nextflow run workflows/<NN-name>/<name>.nf -profile slurm  [--param value ...]
//   nextflow run workflows/<NN-name>/<name>.nf -profile local
//
// Site settings (queue names, GPU type, extra clusterOptions) go in `conf/site.config` (git-ignored), loaded
// automatically if present, or are passed with -c <file> / --cpu_queue / --gpu_queue / --gpu_gres.

def condaExe = System.getenv('CONDA_EXE')

params {
    // Conda environments (envs/*.yaml). The CPU analysis env also provides plink2, bcftools, htslib.
    env_analysis = 'embher_env'
    env_gpu      = 'embher_gpu'
    // conda.sh of the conda that is active when Nextflow starts (override with --conda_sh)
    conda_sh     = condaExe ? "${new File(condaExe).parentFile.parentFile}/etc/profile.d/conda.sh" : 'conda.sh'
    plink        = 'plink2'
    // SLURM partitions/GPU request; ignored by -profile local
    cpu_queue    = 'cpu'
    gpu_queue    = 'gpu'
    gpu_gres     = 'gpu:1'
}

workDir = "${launchDir}/work"

process.cache = 'lenient'

profiles {
    // note: processes that use `array` (job arrays) need -profile slurm; -profile local is for small steps
    local {
        process.executor = 'local'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}

if (new File("${projectDir}/conf/site.config").exists()) {
    includeConfig 'conf/site.config'
}

dag.overwrite    = true
report.overwrite = true
