// SLURM executor settings (-profile slurm). Per-process CPUs, memory and time are set in each workflow;
// queue names come from params.cpu_queue / params.gpu_queue (nextflow.config, or conf/site.config).
executor {
    name             = 'slurm'
    submitRateLimit  = '10 sec'
    // every task of a submitted job array counts toward queueSize
    queueSize        = 5000
}

process {
    executor = 'slurm'
    queue    = { params.cpu_queue }
}
