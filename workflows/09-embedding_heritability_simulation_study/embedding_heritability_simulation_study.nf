#!/usr/bin/env nextflow

/*
 * embedding_heritability_simulation_study -- how well does embedding-GRM REML recover a known h2, and does
 * whitening the kernel fix it? A {kernel} x {phenotype source} benchmark:
 *
 *   kernel        raw          K = ZZ'/M, the full matrix (traditional AI-REML)
 *                 white_k{k} / the top-k whitened GRM, k fixed (--n_pcs) or a fraction
 *                 white_frac{f} of the analysis cohort's rank (--whiten_pc_frac, panel-size
 *                              agnostic -- see pca_embeddings.py), built by the same
 *                              src/scripts/pca_embeddings.py + build_grm.py chain
 *                              workflow 11 runs, so this benchmarks the production path
 *
 *   pheno_source  dense        g ~ N(0, K) -- the model's own assumption, true by
 *                              construction; the one configuration a single-component
 *                              model is guaranteed to fit
 *                 sparse       g = one real embedding feature
 *                 randompc     g = one eigenvector of K, a random PC per replicate among
 *                              those explaining --random_pc_var (default 99%) of the kernel's
 *                              variance. The STANDARD PC geometry.
 *                 pcX          g = one eigenvector of K at a FRACTION X of its rank, the same
 *                              PC in every replicate. Opt-in: --pc_fracs 0.01,0.1,0.3,0.6
 *                 genotype     Simulator_mafld phenotypes on real GTEx haplotypes
 *                              (workflow 07), estimated through the embedding kernel
 *
 * The first four are simulated in the kernel's own eigenbasis, so WHERE the signal sits
 * is known and controlled -- that is what exposes the estimator's dependence on geometry,
 * which `dense` alone cannot show. The genotype arm gives up that control on purpose: its
 * signal lands wherever real biology puts it, and its bias therefore also reflects how
 * much of that signal the embedding captures at all, not just estimator correctness.
 *
 * SOLE ESTIMATOR: src/scripts/exact_reml_heritability.py's --grm-npz mode (exact-trace
 * AI-REML, unconstrained, three starts, at_boundary flag; the joint arm via --bfile +
 * --grm-npz, genotype component first), method exact_reml_from_grm (or
 * exact_reml_from_grm_mac4 for the mac4 joint-genotype split below).
 *
 * --nonneg: the same constrained-REML arm workflow 08 runs under --estimator
 * exact_nonneg (exact_reml_heritability.py --nonneg -- every kernel's variance
 * component >= 0, projected AI-Newton). Applied uniformly to the genosim, joint
 * and geometry arms' exact_reml_heritability.py calls; method labels get a
 * matching exact_reml_ -> exact_reml_nonneg_ rename, so run this as its own
 * --out_dir rather than alongside an unconstrained run.
 *
 * --estimator he: Haseman-Elston regression (src/scripts/he_heritability.py, with its
 * delete-one jackknife SEs) in place of exact REML in all three arms; same inputs and
 * output columns, method labels he_from_grm / he_from_grm_mac4. --nonneg is ignored.
 * HE has no LRT, so the summaries' H0 p-value is the one-sided Wald one.
 *
 * --joint_genotype_bins mac4 (the default) fits the joint arm's genotype component as
 * the 4-bin cohort MAC/MAF split (method exact_reml_from_grm_mac4) instead of one
 * whole-region GRM ('none'); its genotype component is then the sum of the 4 bins
 * (h2_genotype/h2_genotype_se).
 *
 * Embeddings come from workflow 06 (extract_embeddings): this workflow resolves each gene
 * in workflow 06's manifest and runs src/scripts/combine_haplotypes.py to sum the H5's
 * haplotype axis into a donor x feature parquet, the same pattern workflow 11
 * (embedding_heritability) uses for real evaluations -- so the GRM's eigenstructure, and
 * therefore the calibration result, reflects what workflow 11 estimates on. A config gene
 * not captured by workflow 06 fails the whole run immediately, same as workflow 11.
 *
 * Genotype-simulated phenotypes are NOT generated by this pipeline -- they're
 * consumed as already-computed output from workflow 07
 * (results/07-phenotype_simulations/simulations/${genosim_out_dir}/experiments/
 * h2_<h2>_pc_<p_causal>_rep_<genosim_seed>/simulated_phenotypes/pheno.parquet),
 * one experiment per config row's `genosim_seed`. The regions used to simulate
 * those (workflows/07-phenotype_simulations/configs/ten_genes_reml_calibration.tsv)
 * are centered on the identical TSS and the identical window width as this
 * workflow's own embedding windows, so the two kernels see the same genomic
 * interval.
 *
 * Per config row (one gene/region):
 *   [manifest lookup] workflow 06's H5 for this gene_id
 *   combine_haplotypes         sum the H5's haplotype axis -> donor x feature parquet
 *   build_grm                  raw K = ZZ'/M over the embedded panel (shared script)
 *   build_whitened_grm         pca_embeddings.py --n-pcs -> build_grm.py (shared)
 *   prepare_basis              eigendecomposition of the RAW kernel: this is the basis
 *                              the geometries are defined in, for BOTH kernel arms
 *   simulate_geometry_pheno    one task per (gene, geometry, true h2)
 *   estimate_from_genotype_sim one task per (gene, kernel)
 *   summarize_calibration      bias / RMSE / coverage / convergence, one page per metric,
 *                              rows = pheno_source, columns = kernel
 *
 * Config TSV columns (tab-separated, with header):
 *   experiment  gene_id  gene_name  region  genosim_seed
 *     gene_id      : UNVERSIONED ENSG, as workflow 06's H5/manifest key it (no GENCODE
 *                    version suffix) -- unlike workflow 06's manifest, there's no
 *                    window/MAF/tracks variant to disambiguate, so this alone resolves
 *                    the embedding.
 *     region       : chrN:TSS-TSS -- no longer used to resolve the embedding (04b's own
 *                    window is fixed and TSS-centred already), kept only as a tag/for
 *                    the joint arm's genotype-window bookkeeping; gene_name is carried
 *                    through only for tagging.
 *     genosim_seed : the `seed` column value used for this gene in
 *                    params.genosim_config_tsv (workflow 07's own config for
 *                    genosim_out_dir), i.e. which of workflow 07's already-computed
 *                    experiment directories to read phenotypes from.
 *
 * Usage:
 *   nextflow run workflows/09-embedding_heritability_simulation_study/embedding_heritability_simulation_study.nf \
 *     -profile slurm \
 *     --config_tsv workflows/09-embedding_heritability_simulation_study/configs/ten_genes_04b.tsv \
 *     --embeddings_dir results/06-extract_embeddings/gtex/borzoi/<cache_key> \
 *     --genosim_config_tsv workflows/07-phenotype_simulations/configs/ten_genes_04b_reml_calibration.tsv \
 *     --genosim_out_dir ten_genes_04b_reml_calibration \
 *     --out_dir 10_genes_04b_benchmark
 */

// ── Constants ─────────────────────────────────────────────────────────────── //

def SCRIPTS_DIR  = "${projectDir}/scripts"
def SHARED_DIR   = "${projectDir}/../../src/scripts"
def ANALYSIS_ENV = params.env_analysis
def CONDA_SH     = params.conda_sh
// plink2, used by build_cohort_mac_maf4_bins.py to compute the joint arm's mac4 bin
// assignment -- same params.plink (root nextflow.config) workflow 08 uses.
def PLINK    = params.plink
// Matches workflow 11's own slug() exactly -- only used here to keep the combine_
// haplotypes process's prediction-output filename collision-free per experiment;
// wf07 doesn't consume the prediction output at all, only the embedding.
def slug = { s -> s.replaceAll(/[^A-Za-z0-9]/, '_') }

// ── Parameters ────────────────────────────────────────────────────────────── //

params.out_dir     = null
params.config_tsv  = null
// Joint arm's genotype part: 'mac4' (default) = the 4-bin cohort MAC/MAF split
// (MAC<=5 | MAC>5 & MAF<=0.01 | (0.01,0.1] | (0.1,0.5],
// src/scripts/build_cohort_mac_maf4_bins.py, cohort = the simulation panel), fit
// jointly with the embedding kernel; 'none' = one whole-region GRM instead.
params.joint_genotype_bins = 'mac4'
if (!(params.joint_genotype_bins in ['none', 'mac4']))
    error "--joint_genotype_bins must be 'none' or 'mac4'"
def JOINT_MAC4 = params.joint_genotype_bins == 'mac4'
// --nonneg: same constrained-REML arm workflow 08 runs under --estimator exact_nonneg
// (exact_reml_heritability.py --nonneg -- every kernel's variance component >= 0,
// projected AI-Newton). Applied uniformly to every exact_reml_heritability.py call
// below (genosim, joint and geometry arms); method labels get a matching
// exact_reml_ -> exact_reml_nonneg_ rename so a --nonneg run's output is never
// confused with the unconstrained default's.
params.nonneg = true
// --estimator he: Haseman-Elston regression (src/scripts/he_heritability.py,
// with delete-one jackknife SEs) instead of exact REML, in every arm. Same CLI
// (--grm-npz, --bfile, --bin-assignment, --pheno, --method, --true-h2, --experiment,
// --out) and output columns as exact_reml_heritability.py, so the combine/summarize
// steps are unchanged; HE has no LRT, so the summaries use their one-sided Wald p-value.
// --nonneg does not apply to HE (unconstrained) and is ignored; method labels get an
// exact_reml_ -> he_ rename. Run it as its own --out_dir.
params.estimator = 'exact'
if (!(params.estimator in ['exact', 'he']))
    error "--estimator must be exact or he, got ${params.estimator}"
def HE = params.estimator == 'he'
def NONNEG_FLAG  = (!HE && params.nonneg) ? '--nonneg' : ''
def methodLabel = { m -> HE ? m.replaceFirst('exact_reml_', 'he_') :
                         params.nonneg ? m.replaceFirst('exact_reml_', 'exact_reml_nonneg_') : m }
def ESTIMATOR_SCRIPT = HE ? 'he_heritability.py' : 'exact_reml_heritability.py'
// exact_reml_heritability.py's numpy BLAS threads per task.
def EXACT_THREADS = "export OMP_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1} OPENBLAS_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1} MKL_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1}"
// Workflow 06's (extract_embeddings) borzoi/<cache_key> output dir -- see the
// manifest lookup in the workflow{} block below. Same param name/meaning as
// workflow 11's.
params.embeddings_dir = null
// True-h2 grid and replicate count for the calibration sweep. Every replicate is
// a fresh phenotype simulated from the same GRM, so bias/RMSE/coverage at each
// h2 are estimated over n_reps independent draws.
params.h2_grid  = "0,0.05,0.1,0.25,0.5,0.75,0.95"
params.n_reps   = 200
params.seed     = 0
// Geometry arm: where in the raw kernel's eigenbasis the simulated signal is placed,
// as a FRACTION of that kernel's numerical rank (each gene's spectrum differs, so a
// fixed index would mean different things across genes).
params.pc_fracs = "none"   // opt-in fixed-fraction PC geometries, e.g. "0.01,0.1,0.3,0.6"
// randompc geometry (the standard PC geometry): every replicate puts the signal on a
// different uniformly random PC of the raw kernel (the PC analogue of `sparse`), drawn among
// the leading PCs explaining random_pc_var of its variance. --random_pc false drops it.
params.random_pc = true
params.random_pc_var = 0.99
// Whitened kernel arm: size of the retained subspace. k must leave enough directions
// outside it to identify sigma_e^2 (with few residual directions the null SD of h2 is
// large, and with none h2 is not identified). params.n_pcs is a fixed absolute k;
// --whiten_pc_frac is the panel-size-agnostic alternative (see pca_embeddings.py's
// docstring) -- when set, it OVERRIDES n_pcs and k is instead round(whiten_pc_frac *
// rank), recomputed per gene from that gene's own analysis cohort, so k always leaves
// residual directions whatever the cohort size.
params.n_pcs    = 800
// May be a comma-separated list ("0.7,0.9"): one whitened arm per fraction, same experiment.
params.whiten_pc_frac = null
// Add arms to an existing out_dir instead of redoing it: --skip_raw drops the
// raw arm from this run (its basis is still built, the geometries need it) and
// --merge_existing feeds the out_dir's replicates/ and joint_replicates/ into the two
// summaries, so the report shows every arm side by side.
// Use together, with --out_dir naming the existing run and a --whiten_pc_frac whose
// labels are not already there (a clash would stage two files of the same name).
params.skip_raw       = false
params.merge_existing = false
// Genotype-phenotype arm: where to find workflow 07's already-computed
// Simulator_mafld output (see the top-of-file docstring for the exact path
// pattern). h2 values here are strings matching the directory-name format
// workflow 07 actually used ("0.0", not "0"), independent of params.h2_grid's
// own (numerically identical) formatting for the embedding-phenotype arm.
params.genosim_out_dir  = "ten_genes_reml_calibration"
params.genosim_h2_grid  = "0.0,0.05,0.1,0.25,0.5,0.75,0.95"
params.genosim_p_causal = "0.01"
// Joint genotype+embedding arm: workflow 07's OWN config TSV for genosim_out_dir --
// its rows are what determine each genosim_seed's genotype region (see makeGenoBaseName
// below and the workflow{} block's genotype_bfile_by_seed resolution). Needed because
// the genotype merged.bed lives at a path keyed by region/maf/ld/mafex, not by seed;
// this file is the only place that mapping exists. No default -- genosim_out_dir and
// this file describe the SAME workflow-07 run and must be passed together explicitly,
// so a mismatched pair (e.g. reusing an old default against a new gene set) can never
// happen silently.
params.genosim_config_tsv = null

if (!params.out_dir)     error "Please specify --out_dir"
if (!params.config_tsv)  error "Please specify --config_tsv"
if (!params.embeddings_dir) error "Please specify --embeddings_dir (workflow 06's " +
    "borzoi/<cache_key> output directory)"
if (!params.genosim_config_tsv) error "Please specify --genosim_config_tsv (workflow " +
    "05's own config TSV for --genosim_out_dir)"

def OUT_PREFIX = "${launchDir}/results/09-embedding_heritability_simulation_study/${params.out_dir}"
def GENOSIM_GEN_PREFIX = "${launchDir}/results/07-phenotype_simulations/simulations/${params.genosim_out_dir}/genotypes"

// Copy of workflow 07's simulate_phenotypes.nf makeBaseName closure -- MUST stay in
// sync with that file. Needed to resolve a genosim_seed (wf07 config's own key) to
// the genotype merged.bed/.bim/.fam directory wf05 published it under, since that
// directory is keyed by region/maf/ld/maf_ex/panel, not by seed.
def makeGenoBaseName = { cfg ->
    def r = cfg.region.replace(':', '_').replace('-', '_')
    "region_${r}_maf${cfg.min_maf}_${cfg.max_maf}_ld${cfg.ld_ex}_mafex${cfg.maf_ex}_${cfg.panel}".toLowerCase()
}

// 04's manifest reader (src/nf/embeddings_manifest.nf): the 04 directory name no longer carries the
// pooling, so the rows are filtered on the manifest's own pooling columns.
include { loadEmbeddingsManifest } from '../../src/nf/embeddings_manifest.nf'
def EMBEDDINGS_MANIFEST = loadEmbeddingsManifest(params.embeddings_dir, [pooling_axes: ['seq_dim'], pooling_funcs: ['mean']])




// ──────────────────────────────────────────────────────────────────────────── //
// Process 3b: resolve each gene's workflow-06 H5 into a donor x feature embedding
//             parquet by summing its haplotype axis -- same script/process pattern
//             as workflow 11's embedding_heritability.nf, since 04b never publishes
//             a ready-made donor-keyed parquet the way workflow 06 did.
// ──────────────────────────────────────────────────────────────────────────── //

process combine_haplotypes {
    array 1000
    cpus 1
    memory { 8.GB * task.attempt }
    time { 30.min * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}"

    publishDir { "${OUT_PREFIX}/embeddings" }, mode: 'copy', pattern: "*_embedding.parquet"

    input:
    tuple val(experiment), val(gene_id_slug), val(gene_id_h5), path(h5)
    // Staged explicitly (not interpolated via SHARED_DIR) so an edit to
    // combine_haplotypes.py invalidates this process's Nextflow cache.
    path(combine_script)

    output:
    tuple val(experiment), path("${experiment}_embedding.parquet"), emit: emb
    path("${experiment}_${gene_id_slug}_prediction.parquet"), emit: pred

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}
    python ${combine_script} \\
        --h5 ${h5} \\
        --gene-id ${gene_id_h5} \\
        --tracks 7531,7532,7533 \\
        --out-embedding ${experiment}_embedding.parquet \\
        --out-prediction ${experiment}_${gene_id_slug}_prediction.parquet
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 4: embedding GRM over the whole embedded GTEx panel (no phenotype to
//            subset to -- this is a pure estimator test, not a real analysis).
// ──────────────────────────────────────────────────────────────────────────── //

process build_grm {
    cpus 4
    memory { 16.GB * task.attempt }
    time { 2.h * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}"

    publishDir { "${OUT_PREFIX}/grm" }, mode: 'copy'

    input:
    tuple val(experiment), val(region), path(emb)

    output:
    tuple val(experiment), val(region), path("${experiment}.npz")

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}

    python ${SHARED_DIR}/build_grm.py \\
        --embeddings ${emb} \\
        --out ${experiment}
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 5a: the WHITENED kernel, via the production chain. Identical to what
//             workflow 11's embedding_heritability runs under --n_pcs, so this
//             benchmark exercises the production code path rather than a local
//             reimplementation of the same algebra.
// ──────────────────────────────────────────────────────────────────────────── //

process build_whitened_grm {
    cpus 4
    memory { 16.GB * task.attempt }
    time { 2.h * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}"

    publishDir { "${OUT_PREFIX}/whitened_grm" }, mode: 'copy', pattern: "*.npz"

    input:
    // Scripts staged as real path inputs, not interpolated via SHARED_DIR: a path that
    // appears only inside the script STRING is not part of the task hash, so -resume
    // would replay a stale GRM after an edit to either script.
    // white_label names the arm (white_frac0.7 / white_k800) and is part of the output
    // file name, so several fractions can run in one experiment; pc_arg is its CLI flag.
    tuple val(experiment), val(region), val(white_label), val(pc_arg), path(emb), path(pca_script), path(grm_script)

    output:
    tuple val(experiment), val(region), val(white_label), path("${experiment}_${white_label}.npz")

    script:
    def pcArg = pc_arg
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}
    export OMP_NUM_THREADS=${task.cpus}
    export OPENBLAS_NUM_THREADS=${task.cpus}

    python ${pca_script} \\
        --embeddings ${emb} \\
        ${pcArg} \\
        --out ${experiment}_${white_label}_pcs.parquet

    python ${grm_script} \\
        --embeddings ${experiment}_${white_label}_pcs.parquet \\
        --out ${experiment}_${white_label}
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 5b: the eigenbasis the geometries are defined in. Computed from the RAW
//             kernel and shared by BOTH kernel arms, so `dense`/`pcX` mean the same
//             thing whichever kernel is doing the estimating.
// ──────────────────────────────────────────────────────────────────────────── //

process prepare_basis {
    cpus 2
    memory { 8.GB * task.attempt }
    time { 1.h * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}"

    publishDir { "${OUT_PREFIX}/basis" }, mode: 'copy'

    input:
    tuple val(experiment), val(region), path(npz), path(emb), path(script)

    output:
    tuple val(experiment), val(region), path("${experiment}_basis.npz")

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}
    export OMP_NUM_THREADS=${task.cpus}
    export OPENBLAS_NUM_THREADS=${task.cpus}

    python ${script} \\
        --grm-npz ${npz} \\
        --emb-parquet ${emb} \\
        --experiment '${experiment}' \\
        --out ${experiment}_basis.npz
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 7: bias / RMSE / 95% CI coverage summary across all genes, both
//            phenotype sources -- exact_reml_heritability.py's own REML.
// ──────────────────────────────────────────────────────────────────────────── //

process summarize_calibration {
    cpus 1
    memory { 8.GB * task.attempt }
    time { 30.min * task.attempt }
    errorStrategy 'retry'
    maxRetries 2

    publishDir { "${OUT_PREFIX}" }, mode: 'copy'

    input:
    path(calibration)
    path(script)

    output:
    path("summary.parquet")
    path("calibration.pdf")

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}

    python ${script} \\
        --calibration ${calibration} \\
        --out-summary summary.parquet \\
        --out-pdf calibration.pdf
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 10: bias / RMSE / 95% CI coverage summary for the joint arm, faceted
//             {component: genotype, embedding} x {kernel} -- exact_reml_heritability.py's
//             own two-component REML.
// ──────────────────────────────────────────────────────────────────────────── //

process summarize_joint_calibration {
    cpus 1
    memory { 8.GB * task.attempt }
    time { 30.min * task.attempt }
    errorStrategy 'retry'
    maxRetries 2

    publishDir { "${OUT_PREFIX}" }, mode: 'copy'

    input:
    path(calibration)
    path(script)

    output:
    path("joint_summary.parquet")
    path("joint_calibration.pdf")

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}

    python ${script} \\
        --calibration ${calibration} \\
        --out-summary joint_summary.parquet \\
        --out-pdf joint_calibration.pdf
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 12: exact_reml_heritability.py's --grm-npz from-GRM mode on the single
//             embedding kernel + genotype-simulated phenotypes -- one call per
//             true_h2 value (each is its own pheno.parquet), combined into one
//             per-(gene,kernel) parquet.
// ──────────────────────────────────────────────────────────────────────────── //

process exact_from_grm_genosim {
    array 1000
    cpus 1
    memory { 2.GB * task.attempt }
    time { 8.h * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}:${kernel_label}"

    // One row per simulated replicate (the input summarize_* aggregates): kept so the
    // per-replicate distributions can be re-plotted without refitting.
    publishDir { "${OUT_PREFIX}/replicates" }, mode: 'copy'

    input:
    tuple val(experiment), val(region), val(kernel_label), path(npz), val(h2_values),
          val(pheno_paths), path(reml_script), path(combine_script)

    output:
    path("${experiment}_${kernel_label}_genosim.parquet")

    script:
    def method = methodLabel('exact_reml_from_grm')
    def perH2 = [h2_values, pheno_paths].transpose().collect { h2, phenoPath ->
        "python ${reml_script} --grm-npz ${npz} --pheno '${phenoPath}' ${NONNEG_FLAG} " +
        "--method ${method} --true-h2 ${h2} " +
        "--experiment '${experiment}' --out h2_${h2}.parquet"
    }.join('\n')
    perH2 = EXACT_THREADS + '\n' + perH2
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}

${perH2}

    python ${combine_script} \\
        --parquets h2_*.parquet \\
        --kernel-label '${kernel_label}' \\
        --region '${region}' \\
        --pheno-source 'genotype' \\
        --out ${experiment}_${kernel_label}_genosim.parquet
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 15: exact_reml_heritability.py's two-component REML on the genotype GRM +
//             embedding GRM pair -- its combined --bfile + --grm-npz mode, which
//             builds the genotype component NATIVELY (either one whole-region GRM,
//             or the mac4 bin split below) and fits it jointly with the
//             manually-built (ZZ'/M) embedding npz.
// ──────────────────────────────────────────────────────────────────────────── //

process exact_from_grm_joint {
    array 1000
    cpus 1
    memory { 2.GB * task.attempt }
    time { 8.h * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}:${kernel_label}"

    // One row per simulated replicate (the input summarize_* aggregates): kept so the
    // per-replicate distributions can be re-plotted without refitting.
    publishDir { "${OUT_PREFIX}/joint_replicates" }, mode: 'copy'

    input:
    tuple val(experiment), val(region), val(kernel_label), path(emb_npz),
          path(bed), path(bim), path(fam),
          val(h2_values), val(pheno_paths), path(reml_script), path(combine_script)

    output:
    path("${experiment}_${kernel_label}_joint.parquet")

    script:
    def bfile = bed.baseName
    def jointMethod = methodLabel(JOINT_MAC4 ? 'exact_reml_from_grm_mac4' : 'exact_reml_from_grm')
    def perH2 = [h2_values, pheno_paths].transpose().collect { h2, phenoPath ->
        JOINT_MAC4 ?
        "python ${reml_script} --bfile ${bfile} --bin-assignment mac4.assign.txt --grm-npz ${emb_npz} " +
        "--pheno '${phenoPath}' ${NONNEG_FLAG} " +
        "--method ${jointMethod} --true-h2 ${h2} " +
        "--experiment '${experiment}' --out h2_${h2}.parquet" :
        "python ${reml_script} --bfile ${bfile} --grm-npz ${emb_npz} " +
        "--pheno '${phenoPath}' ${NONNEG_FLAG} " +
        "--method ${jointMethod} --true-h2 ${h2} " +
        "--experiment '${experiment}' --out h2_${h2}.parquet"
    }.join('\n')
    // mac4: one bin assignment per gene, on the simulation panel (every simulated
    // phenotype covers all its donors, so any of this task's pheno files defines it).
    if (JOINT_MAC4)
        perH2 = "python ${SHARED_DIR}/build_cohort_mac_maf4_bins.py --bfile ${bfile} " +
                "--pheno '${pheno_paths[0]}' --plink-bin ${PLINK} --mac-max 5 " +
                "--out mac4.assign.txt\n" + perH2
    perH2 = EXACT_THREADS + '\n' + perH2
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}

${perH2}

    python ${combine_script} \\
        --parquets h2_*.parquet \\
        --kernel-label '${kernel_label}' \\
        --region '${region}' \\
        --out ${experiment}_${kernel_label}_joint.parquet
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 17: simulate the geometry arm's phenotype (make_g/make_y/stable_seed, in
//             simulate_geometry_pheno.py) to a pheno.parquet, so exact_from_grm_geometry
//             (which only reads phenotypes from disk, via --pheno) can fit it. ONE
//             task per (gene, geometry, true h2) --
//             NOT per kernel, since the phenotype is seeded on (experiment, geometry,
//             true_h2, seed) only, so
//             every kernel arm reuses the identical simulated signal.
// ──────────────────────────────────────────────────────────────────────────── //

process simulate_geometry_pheno {
    array 1000
    cpus 1
    memory { 2.GB * task.attempt }
    time { 30.min * task.attempt }
    errorStrategy 'retry'
    maxRetries 2
    tag "${experiment}:${geometry}:h2_${true_h2}"

    input:
    tuple val(experiment), val(region), path(basis), val(geometry), val(true_h2),
          path(script)

    output:
    tuple val(experiment), val(geometry), val(true_h2),
          path("${experiment}_${geometry}_h2${true_h2}_pheno.parquet")

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}

    python ${script} \\
        --basis ${basis} \\
        --experiment '${experiment}' \\
        --geometry '${geometry}' \\
        --true-h2 ${true_h2} \\
        --n-reps ${params.n_reps} \\
        --seed ${params.seed} \\
        --random-pc-var ${params.random_pc_var} \\
        --out ${experiment}_${geometry}_h2${true_h2}_pheno.parquet
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Process 19: exact_reml_heritability.py's --grm-npz from-GRM mode on the kernel +
//             materialized geometry phenotype.
// ──────────────────────────────────────────────────────────────────────────── //

process exact_from_grm_geometry {
    array 1000
    memory { 2.GB * task.attempt }
    time { 5.h * task.attempt }
    // `timeout` bounds each attempt so a hang can't stall the whole array
    // indefinitely, and the errorStrategy gives up gracefully (this one cell missing
    // from the comparison) rather than aborting the entire run once retries -- which
    // mostly help with the OTHER, transient failure mode (an innocent-bystander
    // OOM-kill from the shared node's overall memory pressure) -- are exhausted.
    errorStrategy { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries 2
    // One thread. 200 replicates of an exact 944x944 REML per task -- the slowest
    // cells need ~2.5 h of CPU on one thread, hence the `timeout` and time limit.
    cpus 1
    tag "${experiment}:${kernel_label}:${geometry}:h2_${true_h2}"

    // One row per simulated replicate (the input summarize_* aggregates): kept so the
    // per-replicate distributions can be re-plotted without refitting.
    publishDir { "${OUT_PREFIX}/replicates" }, mode: 'copy'

    input:
    tuple val(experiment), val(region), val(kernel_label), path(npz), val(geometry),
          val(true_h2), path(pheno), path(reml_script), path(combine_script)

    output:
    path("${experiment}_${kernel_label}_${geometry}_h2${true_h2}_geom.parquet") optional true

    script:
    """
    source ${CONDA_SH}
    conda activate ${ANALYSIS_ENV}
    ${EXACT_THREADS}

    timeout 14400 python ${reml_script} \\
        --grm-npz ${npz} \\
        --pheno ${pheno} \\
        ${NONNEG_FLAG} \\
        --method ${methodLabel('exact_reml_from_grm')} \\
        --true-h2 ${true_h2} \\
        --experiment '${experiment}' \\
        --out raw_exact.parquet

    python ${combine_script} \\
        --parquets raw_exact.parquet \\
        --kernel-label '${kernel_label}' \\
        --region '${region}' \\
        --pheno-source '${geometry}' \\
        --out ${experiment}_${kernel_label}_${geometry}_h2${true_h2}_geom.parquet
    """
}


// ──────────────────────────────────────────────────────────────────────────── //
// Workflow
// ──────────────────────────────────────────────────────────────────────────── //

workflow {
    config_ch = Channel
        .fromPath(params.config_tsv)
        .splitCsv(header: true, sep: '\t')
        .map { row ->
            if (!row.experiment || !row.region || !row.gene_id || !row.genosim_seed)
                error "Config row missing experiment/region/gene_id/genosim_seed: ${row}"
            tuple(row.experiment, row.region, row.gene_id, row.genosim_seed)
        }

    // Embeddings resolved against workflow 06's manifest, synchronously (not as a
    // reactive channel) so a missing gene fails the whole run immediately -- same
    // "never silently fall back" pattern as workflow 11. gene_id is matched
    // UNVERSIONED (04b's own gene_meta.tsv/H5 groups carry no GENCODE version
    // suffix), same defensive split as workflow 11 in case a config carries a
    // versioned id. Resolved once per distinct gene_id, since several config rows
    // (experiments) could in principle share one.
    def missing = []
    def h5_by_gene = [:]
    new File(params.config_tsv).withReader { r ->
        def header = r.readLine().split('\t')
        r.eachLine { line ->
            if (!line.trim()) return
            def vals = line.split('\t', -1)
            def row = [:]
            header.eachWithIndex { h, i -> row[h] = i < vals.size() ? vals[i].trim() : '' }
            def geneIdH5 = row.gene_id.split('\\.')[0]
            if (h5_by_gene.containsKey(geneIdH5)) return
            def manRow = EMBEDDINGS_MANIFEST[geneIdH5]
            if (!manRow) {
                missing << "${row.experiment}: ${row.gene_id} (${geneIdH5})"
                h5_by_gene[geneIdH5] = null
            } else {
                h5_by_gene[geneIdH5] = file("${params.embeddings_dir}/${manRow.file_path}")
            }
        }
    }
    if (missing) {
        error "Missing from workflow 06's manifest (${params.embeddings_dir}) -- " +
            "run workflow 06 (extract_embeddings) for these genes first:\n" +
            missing.unique().join('\n')
    }

    h5_by_exp_ch = config_ch
        .map { experiment, region, gene_id, genosim_seed ->
            def geneIdH5 = gene_id.split('\\.')[0]
            tuple(experiment, region, slug(gene_id), geneIdH5, h5_by_gene[geneIdH5]) }

    combined = combine_haplotypes(
        h5_by_exp_ch.map { experiment, region, geneIdSlug, geneIdH5, h5 ->
            tuple(experiment, geneIdSlug, geneIdH5, h5) },
        Channel.value(file("${SHARED_DIR}/combine_haplotypes.py")))

    emb_by_exp_ch = h5_by_exp_ch
        .map { experiment, region, geneIdSlug, geneIdH5, h5 -> tuple(experiment, region) }
        .join(combined.emb)

    // Joint arm: resolve each genosim_seed to workflow 07's genotype merged.bed via
    // its OWN config TSV (params.genosim_config_tsv) and makeGenoBaseName -- the
    // genotype directory is keyed by region/maf/ld/maf_ex/panel, not by seed, so this
    // mapping only exists in that file. Same synchronous-resolution pattern as
    // emb_by_gene_region above, for the same reason (fail the whole run immediately
    // on a missing seed rather than partway through).
    def genotypeBfileBySeed = [:]
    new File(params.genosim_config_tsv).withReader { r ->
        def header = r.readLine().split('\t')
        r.eachLine { line ->
            if (!line.trim()) return
            def vals = line.split('\t', -1)
            def row = [:]
            header.eachWithIndex { h, i -> row[h] = i < vals.size() ? vals[i].trim() : '' }
            def cfg = [
                region  : row.region,
                min_maf : row.min_maf,
                max_maf : row.max_maf,
                ld_ex   : row.ld_ex,
                maf_ex  : row.maf_ex,
                panel   : (row.panel?.trim() ?: 'gtex'),
            ]
            def baseName = makeGenoBaseName(cfg)
            def genoDir = "${GENOSIM_GEN_PREFIX}/${baseName}"
            genotypeBfileBySeed[row.seed] = [
                bed: file("${genoDir}/merged.bed"),
                bim: file("${genoDir}/merged.bim"),
                fam: file("${genoDir}/merged.fam"),
            ]
        }
    }

    genotype_bfile_ch = config_ch
        .map { experiment, region, gene_id, genosim_seed ->
            def paths = genotypeBfileBySeed[genosim_seed]
            if (!paths)
                error "genosim_seed '${genosim_seed}' (experiment ${experiment}) not " +
                    "found in ${params.genosim_config_tsv} -- run workflow 07 " +
                    "(phenotype_simulations) for this seed first."
            tuple(experiment, paths.bed, paths.bim, paths.fam) }

    raw_grm_ch = build_grm(emb_by_exp_ch)

    // --whiten_pc_frac may be a comma-separated list ("0.7,0.9"): one whitened arm per
    // fraction, all in the same experiment and summary. Unset -> the single fixed-k arm.
    def WHITE_ARMS = params.whiten_pc_frac
        ? params.whiten_pc_frac.toString().split(',').collect { it.trim() }
            .collect { f -> [label: "white_frac${f}", arg: "--pc-frac ${f}"] }
        : [[label: "white_k${params.n_pcs}", arg: "--n-pcs ${params.n_pcs}"]]

    white_grm_ch = build_whitened_grm(
        emb_by_exp_ch
            .combine(Channel.fromList(WHITE_ARMS))
            .map { experiment, region, emb, arm ->
                tuple(experiment, region, arm.label, arm.arg, emb,
                      file("${SHARED_DIR}/pca_embeddings.py"),
                      file("${SHARED_DIR}/build_grm.py")) })

    // Both kernel arms, labelled. The label is what reaches the output parquet's
    // `kernel` column and therefore the plot grid's columns. Labelled by the fraction
    // when --whiten_pc_frac is used (k itself varies per gene, unlike a fixed n_pcs).
    kernels_ch = (params.skip_raw ? Channel.empty() : raw_grm_ch.map { e, reg, npz -> tuple(e, reg, 'raw', npz) })
        .mix(white_grm_ch.map { e, reg, label, npz -> tuple(e, reg, label, npz) })

    // The geometries live in the RAW kernel's eigenbasis for both arms, so `dense` and
    // `pcX` mean the same thing no matter which kernel is being scored.
    basis_ch = prepare_basis(
        raw_grm_ch
            .join(emb_by_exp_ch.map { e, reg, emb -> tuple(e, emb) })
            .map { experiment, region, npz, emb ->
                tuple(experiment, region, npz, emb,
                      file("${SCRIPTS_DIR}/prepare_basis.py")) })

    geometries_ch = Channel.fromList(
        ['dense', 'sparse']
        + params.pc_fracs.toString().split(',').collect { it.trim() }
              .findAll { it && it != 'none' }.collect { "pc${it}" }
        + (params.random_pc ? ['randompc'] : []))
    h2s_ch = Channel.fromList(params.h2_grid.toString().split(',').collect { it.trim() })

    genosim_seed_ch = config_ch
        .map { experiment, region, gene_id, genosim_seed -> tuple(experiment, genosim_seed) }

    genosim_input_ch = kernels_ch
        .combine(genosim_seed_ch, by: 0)
        .map { experiment, region, kernel_label, npz, genosim_seed ->
            def h2s = params.genosim_h2_grid.split(',') as List
            def phenoPaths = h2s.collect { h2 ->
                "${launchDir}/results/07-phenotype_simulations/simulations/${params.genosim_out_dir}/experiments/h2_${h2}_pc_${params.genosim_p_causal}_rep_${genosim_seed}/simulated_phenotypes/pheno.parquet"
            }
            tuple(experiment, region, kernel_label, npz, h2s, phenoPaths)
        }

    // ── Joint genotype+embedding arm ─────────────────────────────────────────── //
    // Genotype component is built natively by exact_reml_heritability.py itself
    // (--bfile) -- see exact_from_grm_joint -- so genotype_bfile_ch's bed/bim/fam are
    // passed straight through rather than pre-built into an npz.

    // combine(by:0) appends genotype_bfile_ch's non-key fields (bed, bim, fam) at
    // the END, so re-map into the order exact_from_grm_joint's input: block declares.
    joint_input_ch = genosim_input_ch
        .combine(genotype_bfile_ch, by: 0)
        .map { experiment, region, kernel_label, emb_npz, h2s, phenoPaths, bed, bim, fam ->
            tuple(experiment, region, kernel_label, emb_npz, bed, bim, fam, h2s, phenoPaths) }

    reml_script_ch = Channel.value(file("${SHARED_DIR}/${ESTIMATOR_SCRIPT}"))
    combine_genosim_script_ch = Channel.value(file("${SCRIPTS_DIR}/combine_grm_genosim.py"))
    combine_joint_script_ch   = Channel.value(file("${SCRIPTS_DIR}/combine_grm_joint.py"))

    joint_ch = exact_from_grm_joint(
        joint_input_ch.combine(reml_script_ch)
                      .combine(combine_joint_script_ch))

    summarize_joint_script_ch = Channel.value(file("${SCRIPTS_DIR}/summarize_joint_calibration.py"))
    def existing_joint_ch = channel.empty()
    if (params.merge_existing) existing_joint_ch = channel.fromPath("${OUT_PREFIX}/joint_replicates/*.parquet")
    summarize_joint_calibration(joint_ch.mix(existing_joint_ch).collect(), summarize_joint_script_ch)

    // ── Genosim arm (single embedding kernel, real genotype-simulated phenotypes) ─ //

    genosim_ch = exact_from_grm_genosim(
        genosim_input_ch.combine(reml_script_ch)
                         .combine(combine_genosim_script_ch))

    // ── Geometry arm (dense/sparse/pcX synthetic signal) ─────────────────────── //
    // The phenotype is materialized once per (gene, geometry, true_h2) -- NOT per
    // kernel, since simulate_geometry_pheno.py's make_g/make_y/stable_seed seed it on (experiment, geometry, true_h2, seed)
    // only -- then cross-joined with every kernel.

    geometry_pheno_ch = simulate_geometry_pheno(
        basis_ch.combine(geometries_ch)
                .combine(h2s_ch)
                .map { e, reg, b, geom, h2 ->
                    tuple(e, reg, b, geom, h2,
                          file("${SCRIPTS_DIR}/simulate_geometry_pheno.py")) })

    geometry_kernel_input_ch = kernels_ch
        .combine(geometry_pheno_ch, by: 0)
        .map { e, reg, lbl, npz, geom, h2, pheno ->
            tuple(e, reg, lbl, npz, geom, h2, pheno) }

    geometry_ch = exact_from_grm_geometry(
        geometry_kernel_input_ch.combine(reml_script_ch)
                                 .combine(combine_genosim_script_ch))

    // ── Pooled bias/RMSE/coverage/QQ report (genosim + geometry) ─────────────── //

    summarize_script_ch = Channel.value(file("${SCRIPTS_DIR}/summarize_calibration.py"))
    def existing_rep_ch = channel.empty()
    if (params.merge_existing) existing_rep_ch = channel.fromPath("${OUT_PREFIX}/replicates/*.parquet")
    summarize_calibration(genosim_ch.mix(geometry_ch).mix(existing_rep_ch).collect(), summarize_script_ch)
}
